# ===========================================================================
# Advanta Home Tutions — environment variables
# ===========================================================================
# Copy this file to `.env.local` for local development, or add the same
# variables in your hosting provider's dashboard for production.
#
#   PowerShell:  Copy-Item .env.example .env.local
#   macOS/Linux: cp .env.example .env.local
#
# NEVER commit real values. `.env*` files (except this example) are gitignored.
#
# Variables starting with NEXT_PUBLIC_ are embedded into the browser bundle at
# BUILD time. If you change one, rebuild/redeploy the site.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. Site address (required for production)
# ---------------------------------------------------------------------------
# The public https address of the website, with no trailing slash.
# Used for canonical URLs, Open Graph tags, the sitemap and robots.txt.
# Local development can leave this blank (defaults to http://localhost:3000).
#
# Production example: NEXT_PUBLIC_SITE_URL=https://advantahometutions.in
NEXT_PUBLIC_SITE_URL=


# ---------------------------------------------------------------------------
# 2. Public contact details (optional)
# ---------------------------------------------------------------------------
# Leave any value blank and the website shows an honest "not yet available"
# state instead of a broken link. Fill these in when the details are real.
#
# Phone number for click-to-call. Include the country code.
# Example: NEXT_PUBLIC_BUSINESS_PHONE=+91 98765 43210
NEXT_PUBLIC_BUSINESS_PHONE=

# WhatsApp number in international format (country code, no + or spaces).
# Only public business numbers — never a personal number you do not want listed.
# The website only opens WhatsApp after the visitor clicks a button.
# Example: NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public contact email address.
# Example: NEXT_PUBLIC_BUSINESS_EMAIL=hello@advantahometutions.in
NEXT_PUBLIC_BUSINESS_EMAIL=

# Free-text opening hours shown on the Contact page.
# Example: NEXT_PUBLIC_BUSINESS_HOURS=Monday–Saturday, 10:00–19:00 IST
NEXT_PUBLIC_BUSINESS_HOURS=


# ---------------------------------------------------------------------------
# 3. Social profiles (optional)
# ---------------------------------------------------------------------------
# Full profile URLs. Blank = the icon/link is hidden. Do not add profiles that
# do not exist yet.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=


# ---------------------------------------------------------------------------
# 4. Verified service areas (optional)
# ---------------------------------------------------------------------------
# Comma-separated list of localities the agency genuinely serves. This powers
# the honest service-area copy and the locality pages under /home-tutor/<area>.
#
# IMPORTANT: only list areas you can actually cover. Leave blank until the
# team has confirmed them; the site will then describe the coverage as
# "Varanasi" without naming localities.
#
# Example: NEXT_PUBLIC_SERVICE_AREAS=Sigra, Lanka, Bhelupur, Cantt
NEXT_PUBLIC_SERVICE_AREAS=


# ---------------------------------------------------------------------------
# 5. Google Sheets — automatic lead records (recommended)
# ---------------------------------------------------------------------------
# Two separate Google Sheets receive the two forms:
#   - parent enquiries  -> GOOGLE_SHEETS_PARENT_WEBHOOK_URL
#   - tutor applications -> GOOGLE_SHEETS_TUTOR_WEBHOOK_URL
#
# Each URL is a Google Apps Script web app URL ending in /exec. See
# google-apps-script/Code.gs and the README setup guide.
#
# SERVER-SIDE ONLY. Never prefix these with NEXT_PUBLIC_.
#
# The same long random secret must be set in both Apps Script deployments and
# here. Generate one with a password manager, for example:
#   openssl rand -hex 32
# If this secret is exposed, change it in Apps Script and redeploy the site.
GOOGLE_SHEETS_PARENT_WEBHOOK_URL=
GOOGLE_SHEETS_TUTOR_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# 6. Supabase — optional database and private tutor-document storage
# ---------------------------------------------------------------------------
# Optional if Google Sheets is configured. Supabase is still required for
# private tutor-document uploads. Without Google Sheets or Supabase, production
# forms return an honest "not connected yet" message and never pretend to save.
# See README.md for the step-by-step setup.
#
# Project URL (Project Settings → API → Project URL). Must be https://…supabase.co
SUPABASE_URL=

# Service-role key (Project Settings → API → service_role / secret key).
# SERVER-SIDE ONLY. Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Private storage bucket for tutor verification documents.
# Must match the bucket created by supabase/schema.sql.
SUPABASE_STORAGE_BUCKET=tutor-documents


# ---------------------------------------------------------------------------
# 7. Development-only local storage (optional)
# ---------------------------------------------------------------------------
# In development, forms automatically save to `.data/` when Google Sheets and
# Supabase are not configured, so the whole flow can be tested. `.data/` is
# gitignored and never served publicly.
#
# Folder for local JSONL records and private uploads. Default: ./.data
# LOCAL_DATA_DIR=

# Keep local file storage ON in a production build (e.g. a self-hosted demo).
# Do NOT enable this on serverless hosting: its filesystem is ephemeral.
# LOCAL_LEAD_STORE=false


# ---------------------------------------------------------------------------
# 8. Optional operator notification webhook
# ---------------------------------------------------------------------------
# If set, the server POSTs a small JSON summary when a new enquiry or tutor
# application is received. Useful for email/Slack/Google Sheets automations.
# The full home address is deliberately omitted from the summary.
#
# LEAD_NOTIFICATION_WEBHOOK_URL=
# LEAD_WEBHOOK_SECRET=
